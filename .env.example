# Server
PORT=3000
NODE_ENV=development

# Database (local MySQL via docker-compose)
DATABASE_URL=mysql://root:password@localhost:3307/etgy_db

# Redis (local via docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stats / rankings cache
STATS_CACHE_ENABLED=true
STATS_CACHE_TTL_SECONDS=300
STATS_CACHE_TTL_SCHOOLS_SECONDS=600
STATS_CACHE_TTL_ME_SECONDS=120

# JWT
JWT_SECRET=please_change_me
JWT_EXPIRES_IN=7d

# Reverse proxy / rate limit
# If your backend is behind Nginx/Ingress/Cloud LB, set TRUST_PROXY=true to use X-Forwarded-For.
TRUST_PROXY=false
# Coarse /api/* rate limit (defaults: prod=120/min, dev=1000/min)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# OSS (optional)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_PRESIGN_EXPIRES_SECONDS=

# AI Service (optional)
AI_API_KEY=

# Layer 2 NLP 审核服务 (Python FastAPI 微服务)
# 部署时先上传模型文件: scp -r layer2_nlp/runs/ user@server:/path/to/etgy_back/layer2_nlp/
# 然后启动: python start_nlp_service.py
LAYER2_NLP_URL=http://127.0.0.1:8001
LAYER2_NLP_ENABLED=true

# Agora RTC (optional)
# NOTE: Do NOT commit your certificate. Put it only in .env.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_RTC_TOKEN_EXPIRE_SECONDS=3600

# Child account device binding (global switch; default off)
CHILD_DEVICE_BINDING_ENABLED=false

# WeChat Mini Program (optional)
# Fill from WeChat Mini Program admin console (开发管理 -> 开发设置)
WECHAT_MP_APP_ID=wx_your_appid_here
WECHAT_MP_APP_SECRET=your_app_secret_here
WECHAT_MP_BIND_TOKEN_EXPIRE_SECONDS=600

# iFlytek Spark (讯飞星火) Spark X1.5 (optional)
# HTTP OpenAPI (OpenAI compatible). Auth header: Authorization: Bearer <SPARK_HTTP_API_PASSWORD>
# Docs often use /v1/chat/completions; some accounts may use /v2/chat/completions.
SPARK_HTTP_ENDPOINT=https://spark-api-open.xf-yun.com/v2/chat/completions
SPARK_HTTP_API_PASSWORD=your_http_api_password_here
# Spark X1.5 maps to Ultra model in HTTP OpenAPI
SPARK_HTTP_MODEL=4.0Ultra

# WebSocket (signed URL auth) - if you use the WS endpoint
SPARK_WS_URL=wss://spark-api.xf-yun.com/v1/x1
SPARK_WS_APP_ID=your_ws_appid_here
SPARK_WS_API_KEY=your_ws_apikey_here
SPARK_WS_API_SECRET=your_ws_apisecret_here

# Dify.cloud (AI 编排平台)
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_CHATFLOW_API_KEY=
DIFY_HTTP_TIMEOUT_MS=60000

# AI Tutor 风控开关（生产环境上线前全部开启为 true）
AI_TUTOR_MODERATION_ENABLED=false
AI_TUTOR_RISK_DETECTION_ENABLED=false
AI_TUTOR_DAILY_LIMIT_ENABLED=false
AI_TUTOR_AUDIT_ENABLED=false

# AI Tutor (儿童 AI 辅导)
# - Uses Spark HTTP by default (see SPARK_HTTP_* above)
# - Dify priority: if DIFY_CHATFLOW_API_KEY is set, uses Dify SSE streaming; otherwise falls back to Spark
# - Daily limit is enforced via Redis when available (fail-open if Redis is down)
AI_TUTOR_ENABLED=true
AI_TUTOR_DAILY_LIMIT=5
AI_TUTOR_MAX_INPUT_LENGTH=200
AI_TUTOR_CONTEXT_MESSAGES=8
